# Configurações públicas do Supabase (opcionais; também podem ser informadas no app)
# Use somente a chave publishable/anon. Nunca coloque uma service_role/secret key no aplicativo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Defina também no host do Socket.IO (Render, por exemplo):
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
REQUIRE_SOCKET_AUTH=true
