{
  "name": "lpp2-hub",
  "private": true,
  "version": "1.0.0",
  "description": "LPP2 Game Development Studio Hub - Discord, Aseprite, Whiteboard & Backups",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.cjs",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE,ELECTRON\" -c \"yellow.bold,cyan.bold,green.bold\" \"npm run dev:server\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "web": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE\" -c \"yellow.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev:server": "cross-env NODE_ENV=development node server/index.cjs",
    "build": "tsc -b && vite build",
    "build:exe": "npm run build && electron-builder --win portable",
    "build:installer": "npm run build && electron-builder --win nsis",
    "build:all": "npm run build && electron-builder --win portable nsis",
    "release": "npm run build && electron-builder --publish always",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.lpp2.studio",
    "productName": "LPP2 Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "RafaelLiborio",
        "repo": "LPP2"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
